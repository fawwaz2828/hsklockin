# Salin ke .env lalu isi. .env JANGAN di-commit.

# Login + sinkron progres (opsional). Supabase → Project Settings → API Keys (publishable key).
# Key ini memang boleh publik (akses dibatasi Row Level Security di supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Audio Azure Neural TTS untuk scripts/build-tts.mjs (opsional).
# Azure portal → buat "Speech service" (tier Free F0) → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Opsional: ganti suara
# TTS_VOICE_WORD=zh-CN-XiaoxiaoNeural
# TTS_VOICE_FEMALE=zh-CN-XiaoxiaoNeural
# TTS_VOICE_MALE=zh-CN-YunxiNeural
# TTS_VOICE_NARRATOR=zh-CN-YunyangNeural
